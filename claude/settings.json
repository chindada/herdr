{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${HC_TERMINAL_ID:-}\" ]; then \"$HOME/.local/bin/herdr-context\" save claude; fi",
            "timeout": 5,
            "onFailure": "block",
            "statusMessage": "Saving task checkpoint"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/herdr-context\" start",
            "timeout": 5,
            "statusMessage": "Checking task checkpoint"
          }
        ]
      }
    ]
  },
  "autoCompactEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/herdr-statusline.sh"
  },
  "remoteControlAtStartup": false
}
